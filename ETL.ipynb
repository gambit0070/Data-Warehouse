{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Extract data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1097,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1098,
   "metadata": {},
   "outputs": [],
   "source": [
    "# # Ensure the required library is installed \n",
    "# (Can we do it (openpyxl)? Will it be a problem?)\n",
    "# %pip install openpyxl\n",
    "\n",
    "# Read the Excel files\n",
    "file_path = \"bitre_fatalities_dec2024.xlsx\"\n",
    "df = pd.read_excel(file_path, sheet_name=\"BITRE_Fatality\", skiprows=4) # Can be improved\n",
    "\n",
    "file_path = \"Population.xlsx\"\n",
    "population = pd.read_excel(file_path, sheet_name=\"Table 1\", skiprows=5) # Can be improved\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1099,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "Index(['crash_id', 'state', 'month', 'year', 'dayweek', 'time', 'crash_type',\n",
       "       'bus_involvement', 'heavy_rigid_truck_involvement',\n",
       "       'articulated_truck_involvement', 'speed_limit', 'road_user', 'gender',\n",
       "       'age', 'national_remoteness_areas', 'sa4_name_2021', 'lga_name',\n",
       "       'road_type', 'christmas_period', 'easter_period', 'age_group',\n",
       "       'day_of_week', 'time_of_day'],\n",
       "      dtype='object')"
      ]
     },
     "execution_count": 1099,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "# Clean the columnnames\n",
    "# Remove leading and trailing whitespace, convert to lowercase, and replace spaces with underscores\n",
    "\n",
    "df.columns = df.columns.str.strip().str.lower().str.replace(' ', '_')\n",
    "\n",
    "# change sa4_name_2021 to sa4_name, national_lga_name_2021 to lga_name\n",
    "df.rename(columns={\n",
    "    'national_lga_name_2021': 'lga_name',\n",
    "    'national_road_type': 'road_type'\n",
    "}, inplace=True)\n",
    "df.columns\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1100,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Adding a victim number for each crash to make composite primary key.\n",
    "df['victim_number'] = df.groupby('crash_id').cumcount() + 1\n",
    "\n",
    "# move the victim_number column to the front\n",
    "cols = df.columns.tolist()\n",
    "cols.insert(1, cols.pop(cols.index('victim_number')))\n",
    "df = df[cols]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1101,
   "metadata": {},
   "outputs": [],
   "source": [
    "# drop 'age', 'gender', 'national_remoteness_areas', 'sa4_name_2021', 'day_of_week'\n",
    "df.drop(columns=['age', 'gender', 'national_remoteness_areas', 'sa4_name_2021', 'day_of_week'], inplace=True)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Data transformation"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Categorizing variables"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1102,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "['Not Rush' 'Rush' nan]\n"
     ]
    }
   ],
   "source": [
    "# convert the 'time' column to datetime format\n",
    "df['time'] = pd.to_datetime(df['time'], format='%H:%M:%S', errors='coerce').dt.time\n",
    "\n",
    "# categorize time of day by rush hous:\n",
    "# Rush hours is morning hours from 07:00 - 09:00 and evening hours 16:00 - 18:00 during working days.\n",
    "Weekday = [\"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\"]\n",
    "\n",
    "conditions = [\n",
    "    (df['christmas_period'] == \"No\") & (df['easter_period'] == \"No\") & (df['dayweek'].isin(Weekday)) & (\n",
    "    ((df['time'] >= pd.to_datetime(\"07:00:00\", format='%H:%M:%S').time()) & (df['time'] <= pd.to_datetime(\"09:00:00\", format='%H:%M:%S').time())) |\n",
    "    ((df['time'] >= pd.to_datetime(\"16:00:00\", format='%H:%M:%S').time()) & (df['time'] <= pd.to_datetime(\"18:00:00\", format='%H:%M:%S').time()))\n",
    "    ),\n",
    "    (df['time'].isna())\n",
    "]\n",
    "\n",
    "choices = [\"Rush\", np.nan]\n",
    "\n",
    "df['time_cat'] = np.select(conditions, choices, default=\"Not Rush\")\n",
    "\n",
    "# change 'nan' value to np.nan\n",
    "df['time_cat'] = df['time_cat'].replace('nan', np.nan)\n",
    "\n",
    "print(df['time_cat'].unique())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1103,
   "metadata": {},
   "outputs": [],
   "source": [
    "# set  NaN values for all 'Other/-9', '-9', 'Unknown', 'Undetermined' in all columns\n",
    "nan_values = ['Other/-9', '-9', 'Unknown', 'Undetermined', -9]\n",
    "df.replace(nan_values, np.nan, inplace=True)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1104,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Values that cannot be converted to int:\n",
      "['<40']\n"
     ]
    }
   ],
   "source": [
    "# check for right data type for speed_limit\n",
    "try :\n",
    "    df['speed_limit'] = df['speed_limit'].astype(float)\n",
    "except ValueError:\n",
    "    # If conversion to int fails, print values that cannot be converted\n",
    "    print(\"Values that cannot be converted to int:\")\n",
    "    print(df[~df['speed_limit'].apply(lambda x: isinstance(x, int) or pd.isna(x))]['speed_limit'].unique())\n",
    "\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "<40 means less than 40, which is 'low' speed category\n",
    "just set this value to 40"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1105,
   "metadata": {},
   "outputs": [],
   "source": [
    "# set '<40' speed_limit to 40\n",
    "df['speed_limit'] = df['speed_limit'].replace('<40', 40)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1106,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "1485\n"
     ]
    }
   ],
   "source": [
    "# speed_limit: Categorise as follows:\n",
    "#     For all except NT:\n",
    "#         0-40 - low\n",
    "#         41-50 - med\n",
    "#         51-80 - high\n",
    "#         81 - inf - very high\n",
    "    \n",
    "#     For NT:\n",
    "#         0-40 - low\n",
    "#         41-60 - med\n",
    "#         61-80 - high\n",
    "#         81 - inf - very high\n",
    "\n",
    "df['speed_limit'] = np.where(\n",
    "    df['state'] != \"NT\",\n",
    "    np.select(\n",
    "        [\n",
    "            (df['speed_limit'] > 0) & (df['speed_limit'] <= 40),\n",
    "            (df['speed_limit'] >= 41) & (df['speed_limit'] <= 50),\n",
    "            (df['speed_limit'] >= 51) & (df['speed_limit'] <= 80),\n",
    "            (df['speed_limit'] > 80)\n",
    "        ],\n",
    "        ['Low', 'Med', 'High', 'Very High'],\n",
    "        default=np.nan\n",
    "    ),\n",
    "    np.select(\n",
    "        [\n",
    "            (df['speed_limit'] > 0) & (df['speed_limit'] <= 40),\n",
    "            (df['speed_limit'] >= 41) & (df['speed_limit'] <= 60),\n",
    "            (df['speed_limit'] >= 61) & (df['speed_limit'] <= 80),\n",
    "            (df['speed_limit'] > 80)\n",
    "        ],\n",
    "        ['Low', 'Med', 'High', 'Very High'],\n",
    "        default=np.nan\n",
    "    )\n",
    ")\n",
    "\n",
    "# change 'nan' value to np.nan\n",
    "df['speed_limit'] = df['speed_limit'].replace('nan', np.nan)            # КОСТЫЛЬ\n",
    "# check if there are any NaN values in speed_limit\n",
    "print(df['speed_limit'].isna().sum())\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1107,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "['Very High' 'High' 'Med' nan 'Low']\n"
     ]
    }
   ],
   "source": [
    "print(df['speed_limit'].unique())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1108,
   "metadata": {},
   "outputs": [],
   "source": [
    "# create holiday column with values: Christmas, Easter, NoHoliday\n",
    "conditions = [\n",
    "    (df['christmas_period'] == \"Yes\"),\n",
    "    (df['easter_period'] == \"Yes\"),\n",
    "    (df['christmas_period'] == \"No\") & (df['easter_period'] == \"No\")\n",
    "]\n",
    "choices = [\"Christmas\", \"Easter\", \"NoHoliday\"]\n",
    "df['holiday_name'] = np.select(conditions, choices, default=np.nan)\n",
    "\n",
    "conditions = [\n",
    "    (df['christmas_period'] == \"Yes\") | (df['easter_period'] == \"Yes\"),\n",
    "    (df['christmas_period'] == \"No\") & (df['easter_period'] == \"No\")\n",
    "]\n",
    "choices = [\"Holiday\", \"NoHoliday\"]\n",
    "df['holiday_type'] = np.select(conditions, choices, default=np.nan)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1109,
   "metadata": {},
   "outputs": [],
   "source": [
    "# create vehicle_type column\n",
    "conditions = [\n",
    "    (df['bus_involvement'] == \"Yes\") | (df['heavy_rigid_truck_involvement'] == \"Yes\") | (df['articulated_truck_involvement'] == \"Yes\"),\n",
    "    (df['bus_involvement'] == \"No\") & (df['heavy_rigid_truck_involvement'] == \"No\") & (df['articulated_truck_involvement'] == \"No\")\n",
    "]\n",
    "\n",
    "choices = [\"Heavy Vehicle Involved\", \"No Heavy Vehicle Involved\"]\n",
    "\n",
    "df['vehicle_type_involved'] = np.select(conditions, choices, default=np.nan)\n",
    "df['vehicle_type_involved'] = df['vehicle_type_involved'].replace('nan', np.nan)"
   ]
  },
